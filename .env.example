# ── App ──────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
HOTEL_TIMEZONE=Asia/Kolkata

# ── MongoDB ──────────────────────────────────────────────────────────
# Must point at a replica set (transactions are mandatory; the app refuses
# to start against a standalone mongod).
# Local docker compose, connecting from the host machine:
MONGODB_URI=mongodb://localhost:27017/midtown_hotel?directConnection=true
# From another container on the compose network:
#   mongodb://mongodb:27017/midtown_hotel?replicaSet=rs0
# Atlas:
#   mongodb+srv://<user>:<password>@<cluster>/midtown_hotel?retryWrites=true&w=majority
MONGODB_MAX_POOL_SIZE=20
# Host port docker compose publishes MongoDB on.
MONGO_HOST_PORT=27017

# ── Auth ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=12h
JWT_REFRESH_EXPIRES_IN=30d

# ── Seeded OWNER account ─────────────────────────────────────────────
OWNER_NAME=Sunil Agrawal
OWNER_PHONE=9000000000
OWNER_EMAIL=owner@midtownhotel.example
OWNER_PASSWORD=change-me-strong-password

# ── Guest OTP / SMS ──────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
# console = log OTP to stdout (development only)
OTP_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=
# msg91 only: the DLT-approved OTP template
SMS_TEMPLATE_ID=

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated origins allowed, no trailing slash.
FRONTEND_MANAGER_URL=http://localhost:5173
FRONTEND_GUEST_URL=http://localhost:5174
